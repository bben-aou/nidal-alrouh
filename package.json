{
  "name": "nidal-alrouh",
  "version": "1.0.0",
  "private": true,
  "description": "Mental health support platform for Morocco",
  "repository": {
    "type": "git",
    "url": "https://github.com/bben-aou/nidal-alrouh.git"
  },
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "concurrently --names \"frontend,backend\" --prefix-colors \"cyan,magenta\" \"yarn workspace @nidal-alrouh/frontend dev\" \"yarn workspace @nidal-alrouh/backend dev\"",
    "build": "concurrently --names \"frontend,backend\" --prefix-colors \"cyan,magenta\" \"yarn workspace @nidal-alrouh/frontend build\" \"yarn workspace @nidal-alrouh/backend build\"",
    "test": "concurrently --names \"frontend,backend\" --prefix-colors \"cyan,magenta\" \"yarn workspace @nidal-alrouh/frontend test\" \"yarn workspace @nidal-alrouh/backend test\"",
    "test:watch": "yarn workspaces foreach -p run test:watch",
    "lint": "concurrently --names \"frontend,backend\" --prefix-colors \"cyan,magenta\" \"yarn workspace @nidal-alrouh/frontend lint\" \"yarn workspace @nidal-alrouh/backend lint\"",
    "lint:fix": "yarn workspaces foreach -p run lint:fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,css,scss}\"",
    "type-check": "yarn workspaces foreach -p run type-check",
    "clean": "yarn workspaces foreach -p run clean && rm -rf node_modules",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^8.0.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.17.0",
    "yarn": ">=1.19.0"
  },
  "keywords": [
    "mental-health",
    "morocco",
    "open-source",
    "nonprofit"
  ],
  "author": "Bilal Ben Aouad",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "next": "15.5.7",
    "validator": "13.15.22"
  }
}
