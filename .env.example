# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Database Connection String (used by your application)
DATABASE_URL=

# Timezone (default: UTC)
TZ=

# =============================================================================
# PGADMIN CONFIGURATION
# =============================================================================

# pgAdmin Web Interface Credentials
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=

# pgAdmin URL: http://localhost:5050
# Login with the email and password above

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================

# Environment
NODE_ENV=development

# Backend application port and API prefix
PORT=8080
API_PREFIX=api

# Application logging level
LOG_LEVEL=info

# =============================================================================
# CORS & SECURITY
# =============================================================================

# Comma-separated list of allowed origins for CORS
# In development, the Next.js frontend runs on port 1999
CORS_ALLOWED_ORIGINS=http://localhost:1999

# Comma-separated list of allowed HTTP methods
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Whether to allow credentials (cookies, Authorization headers)
CORS_CREDENTIALS=true

# Enable security headers via Helmet
HELMET_ENABLED=true

# =============================================================================
# JWT & AUTHENTICATION
# =============================================================================

# JWT Secrets (use strong, random strings in production)
JWT_ACCESS_SECRET=your-super-secret-access-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-characters-long

# JWT Token TTL (Time To Live)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie Configuration
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================

# 1. Copy this file to .env and update values as needed
# 2. Never commit .env to version control
# 3. DATABASE_URL format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# 4. For production, use strong passwords and secure credentials management