# =============================================================================
# BACKEND (Railway) CONFIGURATION
# =============================================================================

# Database
# Use the connection string provided by Railway's PostgreSQL plugin
DATABASE_URL=postgres://user:password@host:port/railway

# Environment
NODE_ENV=production
PORT=8080
API_PREFIX=api
LOG_LEVEL=info

# CORS
# Add your deployed Vercel frontend URL here
CORS_ALLOWED_ORIGINS=https://nidal-alrouh-frontend-bsp4y86ka-bbenaous-projects.vercel.app,https://your-custom-domain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true
HELMET_ENABLED=true

# JWT Secrets (GENERATE NEW RANDOM STRINGS FOR PRODUCTION!)
# You can generate these using `openssl rand -base64 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookies
# Set to your frontend domain (e.g., .vercel.app or your custom domain)
COOKIE_DOMAIN=.vercel.app
COOKIE_SECURE=true

# Cal.com Integration
# The secret you will set in Cal.com webhook settings
CAL_WEBHOOK_SECRET=

# =============================================================================
# FRONTEND (Vercel) CONFIGURATION
# =============================================================================

# API URL
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=https://nidal-alrouh-frontend-bsp4y86ka-bbenaous-projects.vercel.app

# Cal.com
# Your Cal.com account URL
NEXT_PUBLIC_CAL_ORIGIN=https://cal.com
