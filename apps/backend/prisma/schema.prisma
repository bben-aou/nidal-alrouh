generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  email               String                   @unique
  name                String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  id                  String                   @id @default(uuid()) @db.Uuid
  emailVerifiedAt     DateTime?
  passwordHash        String
  role                UserRole                 @default(USER)
  status              UserStatus               @default(active)
  avatarUrl           String?
  Comment             Comment[]
  eventRegistrations  EventRegistration[]
  events              Event[]                  @relation("UserEvents")
  helperProfile       HelperProfile?           @relation("UserHelperProfile")
  HiddenPost          HiddenPost[]
  Message             Message[]                @relation("MessageSender")
  PostLike            PostLike[]
  PostReport          PostReport[]
  Post                Post[]
  reflections         Reflection[]
  resourceBookmarks   ResourceBookmark[]       @relation("UserResourceBookmarks")
  resourceCompletions ResourceCompletion[]     @relation("UserResourceCompletions")
  resourceViews       ResourceView[]           @relation("UserResourceViews")
  resources           Resource[]               @relation("UserResources")
  RoomParticipant     RoomParticipant[]
  sessionFeedback     SessionFeedback[]        @relation("SessionFeedback")
  helperSessions      SupportSession[]         @relation("HelperSessions")
  seekerSessions      SupportSession[]         @relation("SeekerSessions")
  resourcePreferences UserResourcePreference[] @relation("UserResourcePreferences")
  sessions            UserSession[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Reflection {
  id        String            @id @default(uuid()) @db.Uuid
  title     String
  content   String
  mood      ReflectionMood
  privacy   ReflectionPrivacy @default(PRIVATE)
  tags      String[]          @default([])
  userId    String            @db.Uuid
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  wordCount Int               @default(0)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("reflections")
}

model Prompt {
  id           String              @id @default(uuid()) @db.Uuid
  category     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  isActive     Boolean             @default(true)
  translations PromptTranslation[]

  @@map("prompts")
}

model PromptTranslation {
  id        String                @id @default(uuid()) @db.Uuid
  promptId  String                @db.Uuid
  locale    SupportedPromptLocale
  text      String
  tags      String[]              @default([])
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  prompt    Prompt                @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, locale])
  @@map("prompt_translations")
}

model Post {
  id           String                @id @default(uuid()) @db.Uuid
  content      String
  tags         String[]              @default([])
  userId       String                @db.Uuid
  isAnonymous  Boolean               @default(false)
  privacy      PostPrivacy           @default(PUBLIC)
  locale       SupportedPromptLocale
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  quotedPostId String?               @db.Uuid
  comments     Comment[]
  HiddenPost   HiddenPost[]
  likes        PostLike[]
  reports      PostReport[]
  quotedPost   Post?                 @relation("QuotedPost", fields: [quotedPostId], references: [id])
  quotes       Post[]                @relation("QuotedPost")
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([locale, createdAt])
  @@index([userId, createdAt])
  @@index([quotedPostId])
  @@map("posts")
}

model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String   @db.Uuid
  userId      String   @db.Uuid
  content     String
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostReport {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  reason    String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, status])
  @@map("post_reports")
}

model HiddenPost {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("hidden_posts")
}

model ChatRoom {
  id           String            @id @default(uuid()) @db.Uuid
  type         ChatRoomType
  name         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  messages     Message[]
  participants RoomParticipant[]

  @@map("chat_rooms")
}

model RoomParticipant {
  id         String    @id @default(uuid()) @db.Uuid
  roomId     String    @db.Uuid
  userId     String    @db.Uuid
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("room_participants")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  senderId  String   @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])

  @@index([roomId, createdAt])
  @@map("messages")
}

model Event {
  id               String              @id @default(uuid()) @db.Uuid
  title            String
  description      String
  type             EventType
  status           EventStatus         @default(upcoming)
  startDate        DateTime
  endDate          DateTime
  startTime        String
  endTime          String
  timezone         String
  location         String?
  meetingUrl       String?
  maxAttendees     Int?
  currentAttendees Int                 @default(0)
  requiresApproval Boolean             @default(false)
  coverImage       String?
  tags             String[]            @default([])
  organizerId      String              @db.Uuid
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  registrations    EventRegistration[]
  organizer        User                @relation("UserEvents", fields: [organizerId], references: [id])

  @@index([status, startDate])
  @@index([type, startDate])
  @@map("events")
}

model EventRegistration {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  eventId   String             @db.Uuid
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  notes     String?
  status    RegistrationStatus @default(CONFIRMED)
  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_registrations")
}

model Resource {
  id          String               @id @default(uuid()) @db.Uuid
  title       String
  description String
  type        ResourceType
  content     String?
  url         String?
  tags        String[]             @default([])
  authorId    String               @db.Uuid
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  bookmarks   ResourceBookmark[]
  completions ResourceCompletion[]
  views       ResourceView[]
  author      User                 @relation("UserResources", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([authorId])
  @@map("resources")
}

model ResourceView {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  resourceId String   @db.Uuid
  viewedAt   DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation("UserResourceViews", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([resourceId, viewedAt])
  @@map("resource_views")
}

model ResourceBookmark {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  resourceId String   @db.Uuid
  progress   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation("UserResourceBookmarks", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId, updatedAt])
  @@map("resource_bookmarks")
}

model ResourceCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  resourceId  String   @db.Uuid
  completedAt DateTime @default(now())
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user        User     @relation("UserResourceCompletions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId, completedAt])
  @@map("resource_completions")
}

model UserResourcePreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tag       String
  score     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserResourcePreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
  @@index([userId, score])
  @@map("user_resource_preferences")
}

model HelperProfile {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @unique @db.Uuid
  status             HelperStatus     @default(AUTO_VERIFIED)
  bio                String
  specializations    String[]         @default([])
  languages          String[]         @default([])
  maxSessionsPerWeek Int?             @default(4)
  calUsername        String?
  calEventTypeId     String?
  bookingUrl         String?
  licenseNumber      String?
  yearsOfExperience  Int?
  verificationDocs   String[]         @default([])
  verifiedAt         DateTime?
  verifiedBy         String?          @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation("UserHelperProfile", fields: [userId], references: [id], onDelete: Cascade)
  sessions           SupportSession[]

  @@index([status])
  @@index([calUsername])
  @@map("helper_profiles")
}

model SupportSession {
  id              String           @id @default(uuid()) @db.Uuid
  seekerId        String           @db.Uuid
  helperId        String           @db.Uuid
  helperProfileId String           @db.Uuid
  status          SessionStatus    @default(SCHEDULED)
  scheduledAt     DateTime
  duration        Int              @default(50)
  calBookingId    String?
  calBookingUid   String?          @unique
  meetingUrl      String?
  topic           String?
  seekerNote      String?
  helperNote      String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy     String?          @db.Uuid
  cancelReason    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  feedback        SessionFeedback?
  helper          User             @relation("HelperSessions", fields: [helperId], references: [id])
  helperProfile   HelperProfile    @relation(fields: [helperProfileId], references: [id])
  seeker          User             @relation("SeekerSessions", fields: [seekerId], references: [id])

  @@index([seekerId, scheduledAt])
  @@index([helperId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([calBookingId])
  @@map("support_sessions")
}

model SessionFeedback {
  id          String         @id @default(uuid()) @db.Uuid
  sessionId   String         @unique @db.Uuid
  seekerId    String         @db.Uuid
  rating      Int
  comment     String?
  isAnonymous Boolean        @default(true)
  createdAt   DateTime       @default(now())
  seeker      User           @relation("SessionFeedback", fields: [seekerId], references: [id], onDelete: Cascade)
  session     SupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([seekerId])
  @@index([rating])
  @@map("session_feedback")
}

enum UserRole {
  USER
  SEEKER
  HELPER
  ADMIN
}

enum UserStatus {
  pending
  active
  suspended
}

enum ReflectionMood {
  VERY_HAPPY
  HAPPY
  NEUTRAL
  SAD
  VERY_SAD
}

enum ReflectionPrivacy {
  PRIVATE
  PUBLIC
  FRIENDS_ONLY
}

enum SupportedPromptLocale {
  en
  fr
  ar
}

enum EventType {
  workshop
  supportSession
  consultation
  communityMeeting
  webinar
}

enum EventStatus {
  upcoming
  ongoing
  completed
  cancelled
}

enum ChatRoomType {
  DM
  GROUP
}

enum HelperStatus {
  PENDING_VERIFICATION
  VERIFIED
  AUTO_VERIFIED
  SUSPENDED
  REJECTED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PostPrivacy {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ResourceType {
  ARTICLE
  VIDEO
  LINK
}
