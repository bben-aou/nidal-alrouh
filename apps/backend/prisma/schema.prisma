generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  SEEKER
  HELPER
  ADMIN
}

enum UserStatus {
  pending
  active
  suspended
}

enum ReflectionMood {
  VERY_HAPPY
  HAPPY
  NEUTRAL
  SAD
  VERY_SAD
}

enum ReflectionPrivacy {
  PRIVATE
  PUBLIC
  FRIENDS_ONLY
}

enum SupportedPromptLocale {
  en
  fr
  ar
}

enum EventType {
  workshop
  supportSession
  consultation
  communityMeeting
  webinar
}

enum EventStatus {
  upcoming
  ongoing
  completed
  cancelled
}

// -------------------------------
// Chat Feature
// -------------------------------
enum ChatRoomType {
  DM
  GROUP
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  name            String?
  avatarUrl       String?
  passwordHash    String
  role            UserRole   @default(USER)
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  sessions        UserSession[]
  reflections     Reflection[]
  events          Event[]           @relation("UserEvents")
  Post            Post[]
  Comment         Comment[]
  PostLike        PostLike[]
  PostReport      PostReport[]
  HiddenPost      HiddenPost[]
  // Chat relations
  Message         Message[]         @relation("MessageSender")
  RoomParticipant RoomParticipant[]
  eventRegistrations EventRegistration[]
  // Resource relations
  resources       Resource[]        @relation("UserResources")
  resourceViews   ResourceView[]    @relation("UserResourceViews")
  resourceBookmarks ResourceBookmark[] @relation("UserResourceBookmarks")
  resourceCompletions ResourceCompletion[] @relation("UserResourceCompletions")
  resourcePreferences UserResourcePreference[] @relation("UserResourcePreferences")

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Reflection {
  id        String            @id @default(uuid()) @db.Uuid
  title     String
  content   String
  mood      ReflectionMood
  privacy   ReflectionPrivacy @default(PRIVATE)
  tags      String[]          @default([])
  wordCount Int               @default(0)
  userId    String            @db.Uuid
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("reflections")
}

model Prompt {
  id        String   @id @default(uuid()) @db.Uuid
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  translations PromptTranslation[]

  @@map("prompts")
}

model PromptTranslation {
  id        String                @id @default(uuid()) @db.Uuid
  promptId  String                @db.Uuid
  locale    SupportedPromptLocale
  text      String
  tags      String[]              @default([])
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  // Relations
  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, locale])
  @@map("prompt_translations")
}

// -------------------------------
// Community Feed (Posts)
// -------------------------------

enum PostPrivacy {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

model Post {
  id           String                @id @default(uuid()) @db.Uuid
  content      String
  tags         String[]              @default([])
  userId       String                @db.Uuid
  isAnonymous  Boolean               @default(false)
  privacy      PostPrivacy           @default(PUBLIC)
  locale       SupportedPromptLocale
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  quotedPostId String?               @db.Uuid

  // Relations
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   Comment[]
  likes      PostLike[]
  reports    PostReport[]
  quotedPost Post?        @relation("QuotedPost", fields: [quotedPostId], references: [id])
  quotes     Post[]       @relation("QuotedPost")
  HiddenPost HiddenPost[]

  @@index([locale, createdAt])
  @@index([userId, createdAt])
  @@index([quotedPostId])
  @@map("posts")
}

model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String   @db.Uuid
  userId      String   @db.Uuid
  content     String
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostReport {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  reason    String
  status    String   @default("OPEN") // OPEN | REVIEWED | REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, status])
  @@map("post_reports")
}

model HiddenPost {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("hidden_posts")
}

// -------------------------------
// Chat Models
// -------------------------------

model ChatRoom {
  id        String       @id @default(uuid()) @db.Uuid
  type      ChatRoomType
  name      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  participants RoomParticipant[]
  messages     Message[]

  @@map("chat_rooms")
}

model RoomParticipant {
  id         String    @id @default(uuid()) @db.Uuid
  roomId     String    @db.Uuid
  userId     String    @db.Uuid
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  // Relations
  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("room_participants")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  senderId  String   @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([roomId, createdAt])
  @@map("messages")
}

// -------------------------------
// Community Events
// -------------------------------

model Event {
  id               String      @id @default(uuid()) @db.Uuid
  title            String
  description      String
  type             EventType
  status           EventStatus @default(upcoming)
  startDate        DateTime
  endDate          DateTime
  startTime        String
  endTime          String
  timezone         String
  location         String?
  meetingUrl       String?
  maxAttendees     Int?
  currentAttendees Int         @default(0)
  requiresApproval Boolean     @default(false)
  coverImage       String?
  tags             String[]    @default([])
  organizerId      String      @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  organizer User @relation("UserEvents", fields: [organizerId], references: [id], onDelete: Restrict)
  registrations EventRegistration[]

  @@index([status, startDate])
  @@index([type, startDate])
  @@map("events")
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model EventRegistration {
  id        String             @id @default(uuid()) @db.Uuid
  eventId   String             @db.Uuid
  userId    String             @db.Uuid
  status    RegistrationStatus @default(CONFIRMED)
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_registrations")
}

// -------------------------------
// Resources Feature
// -------------------------------

enum ResourceType {
  ARTICLE
  VIDEO
  LINK
}

model Resource {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String
  type        ResourceType
  content     String? // For articles
  url         String? // For videos and links
  tags        String[]     @default([])
  authorId    String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  author User @relation("UserResources", fields: [authorId], references: [id], onDelete: Cascade)
  views       ResourceView[]
  bookmarks   ResourceBookmark[]
  completions ResourceCompletion[]

  @@index([type, createdAt])
  @@index([authorId])
  @@map("resources")
}

// -------------------------------
// Resource Interaction Tracking
// -------------------------------

model ResourceView {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  resourceId String   @db.Uuid
  viewedAt   DateTime @default(now())

  // Relations
  user     User     @relation("UserResourceViews", fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([resourceId, viewedAt])
  @@map("resource_views")
}

model ResourceBookmark {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  resourceId String   @db.Uuid
  progress   Int      @default(0) // 0-100 percentage
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user     User     @relation("UserResourceBookmarks", fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId, updatedAt])
  @@map("resource_bookmarks")
}

model ResourceCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  resourceId  String   @db.Uuid
  completedAt DateTime @default(now())

  // Relations
  user     User     @relation("UserResourceCompletions", fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId, completedAt])
  @@map("resource_completions")
}

model UserResourcePreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tag       String
  score     Float    @default(0) // Interest score for this tag
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation("UserResourcePreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
  @@index([userId, score])
  @@map("user_resource_preferences")
}