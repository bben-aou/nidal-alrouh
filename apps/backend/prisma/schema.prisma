generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SEEKER
  HELPER
  ADMIN
}

enum UserStatus {
  pending
  active
  suspended
}

enum ReflectionMood {
  VERY_HAPPY
  HAPPY
  NEUTRAL
  SAD
  VERY_SAD
}

enum ReflectionPrivacy {
  PRIVATE
  PUBLIC
  FRIENDS_ONLY
}

enum SupportedPromptLocale {
  en
  fr
  ar
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String?
  passwordHash    String
  role            UserRole  @default(USER)
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  sessions UserSession[]
  reflections Reflection[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Reflection {
  id        String            @id @default(uuid()) @db.Uuid
  title     String
  content   String
  mood      ReflectionMood
  privacy   ReflectionPrivacy @default(PRIVATE)
  tags      String[]          @default([])
  wordCount Int               @default(0)
  userId    String            @db.Uuid
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("reflections")
}

model Prompt {
  id        String    @id @default(uuid()) @db.Uuid
  category  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  translations PromptTranslation[]

  @@map("prompts")
}

model PromptTranslation {
  id       String                @id @default(uuid()) @db.Uuid
  promptId String                @db.Uuid
  locale   SupportedPromptLocale
  text     String
  tags     String[]              @default([])
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  // Relations
  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, locale])
  @@map("prompt_translations")
}